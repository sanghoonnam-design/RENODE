# 가상 ISBC 보드 한 번에 실행: 보드 + 부트로더 + 앱 + TCP + 3D 보드 화면.
# Renode Monitor에서:  start @<이 폴더 경로>/isbc-board.resc
# 다른 앱을 올리려면 먼저  $global.appElf=@앱.elf  를 입력한 뒤 위 명령을 실행한다.
# USART1 콘솔 창까지 같이 보려면 isbc-usart.resc를 쓴다(같은 가상 보드).
include $ORIGIN/isbc.resc
include $ORIGIN/isbc-app.resc
include $ORIGIN/isbc-host.resc
logLevel 3
